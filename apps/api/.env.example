# Required
MONGODB_URI=mongodb://localhost:27017/tbc
JWT_SECRET=replace-with-a-long-random-value
PORT=4000
NODE_ENV=development

# Optional — auth token lifetime
JWT_EXPIRES_IN=7d

# Optional — Razorpay (order creation still works without these; only online payment does not)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — WhatsApp Business Cloud API (notifications fail silently + log if unset)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_OWNER_NUMBER=

# CORS — comma-separated list of allowed origins for the mobile app / admin dashboard. The website
# origin (D:\Lickyeat website) is needed so its admin sidebar's "App" nav item can silently log in
# here using the shared admin credentials (see that project's lib/appClient.ts / admin/layout.tsx).
CORS_ORIGINS=http://localhost:5173,http://localhost:3100

# Optional — Google Cloud Storage bucket for image uploads. Leave unset for local dev
# (uploads fall back to writing into apps/api/public/*). Set this on any host with an
# ephemeral filesystem (Cloud Run, Render, etc.) so uploaded images survive restarts.
GCS_BUCKET_NAME=

# Catalog sync with the Lickyeat website (modules/catalogSync) — off unless both are set.
# PEER_URL = the website API's public base URL. SECRET = one long random value (e.g. 64 hex chars),
# identical on both APIs; in production keep it in Secret Manager.
CATALOG_SYNC_PEER_URL=
CATALOG_SYNC_SECRET=
# Optional extra appBrandId=websiteBrandId pairs (TBL=the-biryani-lane is built in).
CATALOG_SYNC_BRAND_ALIASES=
