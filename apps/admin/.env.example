# Absolute API origin, e.g. https://api.lickyeat.com — only needed once the admin dashboard is
# deployed standalone (not reverse-proxied under the same origin as the API). Leave unset for
# local dev: vite.config.ts's dev-server proxy already rewrites relative "/api" calls to
# http://localhost:4000.
#
# Read at BOTH build time (by Vite, via import.meta.env — see src/api/adminClient.ts) and at
# runtime (by server/server.ts, to add this origin to the CSP's connect-src) — set the same value
# both places, or just set it once in whichever environment does both the build and the serve.
VITE_API_BASE_URL=

# The separate Lickyeat website project's (D:\Lickyeat website) own API and admin section — used
# by the sidebar's "Website" nav item (see components/AdminNav.tsx). On login, the same admin
# credentials silently also sign in to the website's backend; clicking "Website" hands that session
# off to its admin without a second password prompt. Dev defaults below already match that
# project's default ports; only override for a real deployed website.
VITE_WEBSITE_API_BASE_URL=http://localhost:4100
VITE_WEBSITE_ADMIN_URL=http://localhost:3100/admin-bridge
